{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "PLA",
  "scopeName": "source.pla",
  "fileTypes": ["pla"],
  "patterns": [
    { "include": "#comment" },
    { "include": "#string" },
    { "include": "#directives" },
    { "include": "#using-directive" },
    { "include": "#conditionals" },
    { "include": "#loop-keywords" },
    { "include": "#function-definition" },
    { "include": "#function-signature" },
    { "include": "#top-level" },
    { "include": "#statement" }
  ],
  "repository": {

    "comment": {
      "patterns": [
        {
          "name": "comment.line.double-dash.pla",
          "match": "--.*$"
        }
      ]
    },

    "string": {
      "patterns": [
        {
          "name": "string.quoted.double.pla",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            { "name": "constant.character.escape.pla", "match": "\\\\." }
          ]
        }
      ]
    },

    "directives": {
      "patterns": [
        {
          "name": "keyword.control.directive.pla",
          "match": "@(?:ifblock|whileblock|endblock)\\b"
        },
        {
          "name": "keyword.control.directive.known.pla",
          "match": "@(?:synthetic|inline|noinline|deprecated|override)\\b"
        },
        {
          "name": "keyword.control.directive.unknown.pla",
          "match": "@[a-zA-Z_][a-zA-Z0-9_]*"
        }
      ]
    },

    "using-directive": {
      "patterns": [
        {
          "name": "meta.directive.using.pla",
          "match": "^\\s*(using)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.control.using.pla" },
            "2": { "name": "support.module.pla" }
          }
        }
      ]
    },

    "conditionals": {
      "patterns": [
        {
          "name": "keyword.control.conditional.pla",
          "match": "\\b(?:else\\s+if|else|if)\\b"
        }
      ]
    },

    "loop-keywords": {
      "patterns": [
        {
          "name": "keyword.control.loop.pla",
          "match": "\\b(?:while)\\b"
        },
        {
          "name": "keyword.control.loop-control.pla",
          "match": "\\b(?:pass|continue)\\b"
        }
      ]
    },

    "function-signature": {
      "patterns": [
        {
          "name": "meta.function.signature.pla",
          "match": "\\b(\\w+)\\s*\\(\\s*(!)(void|bool|int)\\s*\\)\\s*(:)",
          "captures": {
            "1": { "name": "entity.name.function.pla" },
            "2": { "name": "punctuation.definition.return-type.begin.pla" },
            "3": { "name": "storage.type.return.pla" },
            "4": { "name": "punctuation.separator.function.pla" }
          }
        }
      ]
    },

    "function-definition": {
      "patterns": [
        {
          "name": "meta.function.pla",
          "begin": "^\\s*([a-zA-Z_][a-zA-Z0-9_]*)\\s*(:)",
          "beginCaptures": {
            "1": { "name": "entity.name.function.pla" },
            "2": { "name": "punctuation.separator.function.pla" }
          },
          "end": "^(?=\\S)|^\\s*$",
          "patterns": [
            { "include": "#statement" }
          ]
        }
      ]
    },

    "top-level": {
      "patterns": [
        {
          "name": "meta.global.pla",
          "match": "^\\s*(global)\\s+(int|string|bool)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*(=)?\\s*(.*)$",
          "captures": {
            "1": { "name": "storage.modifier.global.pla" },
            "2": { "name": "storage.type.primitive.pla" },
            "3": { "name": "variable.other.global.pla" },
            "4": { "name": "keyword.operator.assignment.pla" },
            "5": { "patterns": [{ "include": "#expression" }] }
          }
        }
      ]
    },

    "statement": {
      "patterns": [
        { "include": "#comment" },
        { "include": "#string" },
        { "include": "#directives" },
        { "include": "#conditionals" },
        { "include": "#loop-keywords" },
        { "include": "#declare-statement" },
        { "include": "#local-declaration" },
        { "include": "#assignment" },
        { "include": "#call-statement" },
        { "include": "#print-statement" },
        { "include": "#cin-statement" },
        { "include": "#exit-statement" },
        { "include": "#return-statement" },
        { "include": "#expression" }
      ]
    },

    "declare-statement": {
      "patterns": [
        {
          "name": "meta.declare.pla",
          "match": "\\b(declare)\\s+(int|string|bool)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "storage.modifier.declare.pla" },
            "2": { "name": "storage.type.primitive.pla" },
            "3": { "name": "variable.parameter.declare.pla" }
          }
        }
      ]
    },

    "local-declaration": {
      "patterns": [
        {
          "name": "meta.declaration.local.pla",
          "match": "\\b(int|string|bool)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*(=)?\\s*(.*)$",
          "captures": {
            "1": { "name": "storage.type.primitive.pla" },
            "2": { "name": "variable.other.local.pla" },
            "3": { "name": "keyword.operator.assignment.pla" },
            "4": { "patterns": [{ "include": "#expression" }] }
          }
        }
      ]
    },

    "assignment": {
      "patterns": [
        {
          "name": "meta.assignment.pla",
          "match": "^\\s*([a-zA-Z_][a-zA-Z0-9_]*)\\s*(=)\\s*(?!.*:\\s*$)(.*)$",
          "captures": {
            "1": { "name": "variable.other.assignment.pla" },
            "2": { "name": "keyword.operator.assignment.pla" },
            "3": { "patterns": [{ "include": "#expression" }] }
          }
        }
      ]
    },

    "call-statement": {
      "patterns": [
        {
          "name": "meta.call.pla",
          "match": "^\\s*(\\.)\\s*([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "punctuation.accessor.dot.pla" },
            "2": { "name": "entity.name.function.call.pla" }
          }
        }
      ]
    },

    "print-statement": {
      "patterns": [
        {
          "name": "meta.print.pla",
          "match": "\\b(print|println)\\s*(\\()",
          "captures": {
            "1": { "name": "support.function.print.pla" },
            "2": { "name": "punctuation.section.parens.begin.pla" }
          }
        }
      ]
    },

    "cin-statement": {
      "patterns": [
        {
          "name": "meta.cin.pla",
          "match": "\\b(cin|cinline)\\s*(\\()",
          "captures": {
            "1": { "name": "support.function.cin.pla" },
            "2": { "name": "punctuation.section.parens.begin.pla" }
          }
        }
      ]
    },

    "exit-statement": {
      "patterns": [
        {
          "name": "meta.exit.pla",
          "match": "\\b(exit)\\s*(\\()\\s*([0-9]+)\\s*(\\))",
          "captures": {
            "1": { "name": "support.function.exit.pla" },
            "2": { "name": "punctuation.section.parens.begin.pla" },
            "3": { "name": "constant.numeric.integer.pla" },
            "4": { "name": "punctuation.section.parens.end.pla" }
          }
        }
      ]
    },

    "return-statement": {
      "patterns": [
        {
          "name": "meta.return.pla",
          "match": "\\b(return)\\b",
          "captures": {
            "1": { "name": "keyword.control.return.pla" }
          }
        }
      ]
    },

    "expression": {
      "patterns": [
        { "include": "#string" },
        { "include": "#number" },
        { "include": "#identifier" },
        { "include": "#parens" },
        { "include": "#operator" }
      ]
    },

    "number": {
      "patterns": [
        {
          "name": "constant.numeric.integer.pla",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },

    "identifier": {
      "patterns": [
        {
          "name": "variable.other.pla",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
        }
      ]
    },

    "parens": {
      "patterns": [
        {
          "name": "punctuation.section.parens.pla",
          "match": "[()]"
        }
      ]
    },

    "operator": {
      "patterns": [
        {
          "name": "keyword.operator.comparison.pla",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.arithmetic.pla",
          "match": "[+\\-*/]"
        },
        {
          "name": "keyword.operator.assignment.pla",
          "match": "="
        }
      ]
    }
  }
}
{
  "comments": {
    "lineComment": "--"
  },
  "brackets": [
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [
    ["(", ")"],
    ["\"", "\""]
  ],
  "wordPattern": "[a-zA-Z_][a-zA-Z0-9_]*",
  "folding": {
    "offSide": true
  },
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(?:[a-zA-Z_][a-zA-Z0-9_]*\\s*:|@ifblock\\b|@whileblock\\b|else\\b.*:|else\\s+if\\b.*:).*$",
    "decreaseIndentPattern": "^\\s*(?:@endblock\\b|@endwhileblock\\b).*$"
  },
  "onEnterRules": [
    {
      "beforeText": "^\\s*[a-zA-Z_][a-zA-Z0-9_]*\\s*:\\s*$",
      "action": { "indent": "indent" }
    },
    {
      "beforeText": "^\\s*@ifblock\\s*$",
      "action": { "indent": "indent" }
    },
    {
      "beforeText": "^\\s*@whileblock\\s*$",
      "action": { "indent": "indent" }
    },
    {
      "beforeText": "^\\s*else\\s*:\\s*$",
      "action": { "indent": "indent" }
    },
    {
      "beforeText": "^\\s*else\\s+if\\b.*:\\s*$",
      "action": { "indent": "indent" }
    },
    {
      "beforeText": "^\\s*if\\b.*:\\s*$",
      "action": { "indent": "indent" }
    },
    {
      "beforeText": "^\\s*@endblock\\s*$",
      "action": { "indent": "outdent" }
    },
    {
      "beforeText": "^\\s*@endwhileblock\\s*$",
      "action": { "indent": "outdent" }
    }
  ]
}
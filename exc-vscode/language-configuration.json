{
  "comments": {
    "lineComment": "--"
  },
  "brackets": [
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [
    ["(", ")"],
    ["\"", "\""]
  ],
  "wordPattern": "[a-zA-Z_][a-zA-Z0-9_]*",
  "folding": {
    "offSide": true
  },
  "indentationRules": {
    "increaseIndentPattern": "^\\s*[a-zA-Z_][a-zA-Z0-9_]*\\s*:\\s*(--.*)?$",
    "decreaseIndentPattern": "^\\s*(?!.*:)\\S"
  }
}
{
  "name": "pla-language",
  "displayName": "PLA Language",
  "description": "Syntax highlighting and language support for .pla files",
  "version": "0.2.0",
  "publisher": "potemkin",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "pla",
        "aliases": ["PLA", "pla"],
        "extensions": [".pla"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "pla",
        "scopeName": "source.pla",
        "path": "./syntaxes/pla.tmLanguage.json"
      }
    ]
  }
}